{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glacc Auto",
  "version": "0.2.1",
  "identifier": "com.miaolab.glacc-auto",
  "build": {
    "frontendDist": "../dist-app",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Glacc Auto",
        "width": 900,
        "height": 600,
        "minWidth": 704,
        "minHeight": 480,
        "resizable": false,
        "maximizable": false,
        "shadow": false,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/glacc-auto-v0.2.1-win-x64/tls-client.dll": "tls-client.dll",
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
